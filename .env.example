# M5 Forecasting Model Laboratory -- environment template.
#
# Copy to `.env` and edit. Every value has a working default in
# src/config/settings.py, so the project runs with no .env file at all.
#
# NOTE: M5 dataset facts (series counts, date ranges, hierarchy levels) are NOT
# configurable and deliberately do not appear here. They live in
# src/config/settings.py as a frozen dataclass, so an environment variable
# cannot silently contradict the data. If an ingest disagrees with them, that is
# a data bug to be raised, not a setting to relax.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
DEBUG=false

# ---------------------------------------------------------------------------
# MLflow
#
# Optional. Every script probes this URI with a short timeout and falls back to
# a local SQLite store when nothing answers, so experiments are never lost to a
# tracking server being down.
#
# SQLite rather than a file store because MLflow 3.x put the filesystem backend
# into maintenance mode, and only a database backend supports the Model
# Registry the promotion gate uses.
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_PREFIX=m5
MLFLOW_REGISTERED_MODEL_NAME=m5_demand_forecaster

# ---------------------------------------------------------------------------
# Modelling
# ---------------------------------------------------------------------------
MODEL_FORECAST_HORIZON=28
MODEL_OUTER_CV_SPLITS=3
MODEL_INNER_CV_SPLITS=3
MODEL_TUNE_TRIALS=30

# Relative margin a challenger must beat the incumbent by before promotion, so
# Production does not churn on fold-to-fold noise.
MODEL_PROMOTION_MIN_IMPROVEMENT_PCT=2.0

# ---------------------------------------------------------------------------
# Drift monitoring
#
# PSI convention (Siddiqi 2006): <0.10 stable, 0.10-0.25 moderate shift,
# >0.25 significant shift warranting investigation.
# ---------------------------------------------------------------------------
MONITOR_PSI_WARN_THRESHOLD=0.10
MONITOR_PSI_ALERT_THRESHOLD=0.25
MONITOR_KS_SIGNIFICANCE_LEVEL=0.05
