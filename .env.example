# =============================================================================
# Supply Chain Platform — Environment Configuration
# Copy to .env and fill in production values. NEVER commit .env to git.
# =============================================================================

# Application
APP_NAME="Supply Chain Intelligence Platform"
APP_VERSION="1.0.0"
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_chain
DB_USER=scplatform
DB_PASSWORD=changeme
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_PREFIX=supply_chain
MLFLOW_ARTIFACT_ROOT=s3://your-bucket/mlflow-artifacts
# MLFLOW_S3_ENDPOINT_URL=http://minio:9000  # If using MinIO instead of S3

# Airflow
AIRFLOW_HOST=localhost
AIRFLOW_PORT=8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLt0nfd3dQ=

# AWS (for S3 artifact storage)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-east-1

# API Security
API_SECRET_KEY=your-secret-key-min-32-chars-change-in-production
API_KEY_HEADER=X-API-Key

# Model Settings
MODEL_FORECAST_HORIZON=28
MODEL_MIN_TRAIN_DAYS=365
MODEL_CV_SPLITS=3
MODEL_FEATURE_VERSION=1
MODEL_MAPE_THRESHOLD=0.20
MODEL_WAPE_THRESHOLD=0.15

# Inventory
INVENTORY_DEFAULT_SERVICE_LEVEL=0.95
INVENTORY_DEFAULT_LEAD_TIME_DAYS=7
INVENTORY_DEFAULT_ORDERING_COST=50.0
INVENTORY_HOLDING_COST_RATE=0.25

# Monitoring
MONITOR_DRIFT_SIGNIFICANCE_LEVEL=0.05
MONITOR_ALERT_EMAIL=alerts@yourcompany.com
MONITOR_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
MONITOR_PROMETHEUS_PORT=8001

# Grafana
GRAFANA_PASSWORD=admin

# Data paths
DATA_DIR=data
MODEL_DIR=models
LOGS_DIR=logs
